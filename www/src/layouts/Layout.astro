---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Community-written solutions to An Infinitely Large Napkin and other mathematics textbooks.',
} = Astro.props;
const repo = 'https://github.com/napkin-community/napkin-community.github.io';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="wordmark" href="/">
          <svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
            <rect x="2" y="2" width="28" height="28" rx="7" fill="#006896"></rect>
            <path d="M16 2 H23 A7 7 0 0 1 30 9 V16 Z" fill="#fff" fill-opacity="0.35"></path>
          </svg>
          Napkin Solutions
        </a>
        <a class="repo" href={repo}>
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Solutions written by the Napkin community. Books belong to their respective authors.</p>
      <p>
        <a href={repo}>Source code</a>
        <span aria-hidden="true">·</span>
        <a href={`${repo}/blob/main/COPYRIGHT`}>Copyright</a>
        <span aria-hidden="true">·</span>
        AGPL-3.0
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-header nav {
    max-width: 1200px;
    height: var(--header-h);
    margin: 0 auto;
    padding: 0 1.25rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .repo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .repo:hover {
    color: var(--accent);
  }

  main {
    flex: 1 0 auto;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.25rem 6rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2rem 1.25rem 3rem;

    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .site-footer p {
    margin: 0.35rem 0;
  }
  .site-footer a {
    color: inherit;
  }
  .site-footer a:hover {
    color: var(--accent);
  }
</style>

<style is:global>
  :root {
    --bg: #f7f5f0;
    --card: #ffffff;
    --ink: #22201d;
    --muted: #6e675b;
    --line: #e5e0d5;
    --accent: #006896;
    --grid: rgb(28 90 120 / 0.055);

    /* Solution sheets stay white in both color schemes, so their ink never flips */
    --sheet: #ffffff;
    --sheet-ink: #22201d;
    --sheet-line: #ece7dd;

    --serif: 'Charter', 'Bitstream Charter', 'Sitka Text', Cambria, Georgia, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;

    --shadow-sm: 0 1px 2px rgb(34 32 29 / 0.06), 0 1px 3px rgb(34 32 29 / 0.05);
    --shadow-md: 0 2px 4px rgb(34 32 29 / 0.06), 0 12px 24px -8px rgb(34 32 29 / 0.14);

    --radius: 10px;
    --header-h: 3.5rem;

    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16181d;
      --card: #1e2127;
      --ink: #e7e4df;
      --muted: #9a958b;
      --line: #2e323a;
      --accent: #58b2da;
      --grid: rgb(255 255 255 / 0.035);

      --shadow-sm: 0 1px 2px rgb(0 0 0 / 0.3), 0 1px 3px rgb(0 0 0 / 0.25);
      --shadow-md: 0 2px 4px rgb(0 0 0 / 0.3), 0 12px 24px -8px rgb(0 0 0 / 0.5);

      color-scheme: dark;
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    min-height: 100vh;
    margin: 0;

    display: flex;
    flex-direction: column;

    background-color: var(--bg);
    background-image:
      linear-gradient(to right, var(--grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px;

    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.6;
  }
  a {
    color: var(--accent);
  }
  ::selection {
    background: color-mix(in srgb, var(--accent) 28%, transparent);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  [id] {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
</style>
