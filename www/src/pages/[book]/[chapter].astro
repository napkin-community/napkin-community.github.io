---
import type { GetStaticPaths } from 'astro';
import { books, getChapters, getChapterContents } from '../../lib/chapter';
import type { Book } from '../../lib/chapter';
import Layout from '../../layouts/Layout.astro';
import Typst from '../../components/Typst.astro';

export const getStaticPaths = (async () =>
  (
    await Promise.all(
      books.map(async (book) =>
        (await getChapters(book)).map((chapter) => ({
          params: { book, chapter: chapter.toString() },
        })),
      ),
    )
  ).flat()) satisfies GetStaticPaths;

const book = Astro.params.book as Book;
const chapter = Number(Astro.params.chapter);
const content = await getChapterContents(book, chapter);
---

<Layout title={`napkin solutions > ${book} > Ch. ${chapter}`}>
  <div id="top"/>
  <a href="../..">Back to Chapter Selection</a>
  <h2>Table of Contents</h2>
  <ol>
    {
      content.map(({ id, display }) => (
        <li>
          <a href={`#${id}`}>{display}</a>
        </li>
      ))
    }
  </ol>
  {
    content.map(({ id, display, body }) => (
      <h2 id={id}>{display}  <a class="anchor" href={`#${id}`}>#</a></h2>
      <Typst code={`
        #set page(
          margin: (left: 5em, right: 5em, top: 0em, bottom: 0em),
          // A4 width 210mm + 5em margin left because of chili
          width: 210mm + 5em,
          height: auto,
        )
        ${body}
      `}/>
    ))
  }
</Layout>

<style>
  ol {
    list-style: none;
  }
  :global(svg) {
    max-width: 80em;
  }
  a.anchor {
    vertical-align: super;
    font-size: 0.75em;
  }
</style>
