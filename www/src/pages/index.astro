---
import Layout from '../layouts/Layout.astro';
import { books, getChapters } from '../lib/chapter';

const bookChapters = await Promise.all(
  books.map(async (book) => ({ book, chapters: await getChapters(book) })),
);
---

<Layout title="napkin solutions">
  <p>Source code: <a href="https://github.com/napkin-community/solutions">https://github.com/napkin-community/solutions</a></p>
  {
    bookChapters.map(({ book, chapters }) => (
      <section>
        <h2 id={book}>{book}</h2>
        <ol>
          {chapters.map((chapter) => (
            <li>
              <a href={`./${book}/${chapter}/`}>Ch. {chapter}</a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Layout>

<style>
  ol {
    display: grid;
    padding: 2rem;
    gap: 2rem;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    list-style: none;
  }
  li {
    aspect-ratio: 3 / 4;
    border: 2px solid black;
    border-radius: 0.25rem;

    display: grid;
  }
  li > a {
    display: grid;
    padding: 1rem;
    place-items: end;

    font-size: 1.5rem;
    color: unset;
  }
</style>
