#black_note[Question 2.3.6][
  Let $M$ be any metric space and $D$ a discrete space.
  When is a map $f : D -> M$ continuous?
]

#solution(users.ghost)[
  always.

  $
    x_n = x quad "for" forall n > N", for enough big" N \
    f(x_n) = f(x)
  $
]
